{
  "line_width": 120,
  "tab_size": 4,
  "max_subargs_per_line": 1,
  "separate_ctrl_name_with_space": false,
  "separate_fn_name_with_space": false,
  "dangle_parens": true,
  "dangle_align": "prefix",
  "min_prefix_chars": 4,
  "max_prefix_chars": 10,
  "max_lines_hwrap": 2,
  "line_ending": "unix",
  "command_case": "lower",
  "keyword_case": "upper",
  "always_wrap": [
    "include_directories",
    "target_include_directories",
    "add_executable",
    "add_library",
    "target_link_libraries"
  ],
  "enable_sort": true,
  "autosort": true,
  "require_valid_layout": false,
  "layout_passes": {},
  "comment_aware_sorting": false,
  "first_comment_is_literal": true
}